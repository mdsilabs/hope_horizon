# ============================================================
# HOPE HORIZON ACADEMY — STUDENT RESULTS MANAGEMENT PORTAL
# Environment variable names only. Never commit real secrets.
# ============================================================

# --- Supabase ---
# From your Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, never exposed to the browser. Used by
# lib/supabase/admin.ts and scripts/seed.ts. Treat this like a root
# database password.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Hope Horizon Academy"

# --- Notifications: EMAIL, WHATSAPP, IN_APP only ---
# EMAIL provider (e.g. SMTP / Resend / SendGrid - configure per school choice)
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# WHATSAPP provider (e.g. WhatsApp Cloud API / Twilio WhatsApp)
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- QR Verification ---
QR_VERIFICATION_BASE_URL=http://localhost:3000/result-verification

# --- File storage ---
# Recommended: use Supabase Storage buckets directly (no extra env vars
# needed beyond the Supabase keys above). Leave these blank unless you
# are deliberately using a different provider for logos/passports/PDFs.
STORAGE_PROVIDER=
STORAGE_BUCKET=

# --- Rate limiting / security (optional, configure as needed) ---
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
