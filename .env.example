# Public project identity is pinned in lib/supabase/config.ts.
# Values here can be overridden locally/deployed, but the URL MUST match
# the pinned project. Only public data goes in this tracked example file.
NEXT_PUBLIC_SUPABASE_URL=https://iwfpdwihinhcwjgvmfei.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QLi8sSbByVHa9luUvJFLeA_1ouCrR7Q

# Server secrets: set these in Vercel -> Project -> Settings ->
# Environment Variables and in your local, untracked .env.local only.
# Prefer a rotated Supabase secret key (SUPABASE_SECRET_KEY).
# Legacy SUPABASE_SERVICE_ROLE_KEY is a fallback for existing deployments.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Approved schema migrations: server-only, configured per school installation.
# Requires the matching Supabase project's direct/session-pooler Postgres URI.
# The original PRIMARY administrator is the only user allowed to run updates.
# Start disabled. Do not use a NEXT_PUBLIC_ prefix or paste the password in chat.
# Initial bootstrap migrations 0001-0014 must be applied before first login.
MIGRATION_RUNNER_ENABLED=false
MIGRATION_DATABASE_URL=

# Demo data must not accidentally be seeded into the production project.
ALLOW_DEMO_SEED=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Hope Horizon Academy"
# Gmail SMTP for application notifications (NOT Supabase Auth recovery emails).
# Use a dedicated Gmail account with 2-Step Verification and an App Password,
# or configure Google OAuth SMTP separately if your account forbids App Passwords.
EMAIL_PROVIDER=gmail
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
QR_VERIFICATION_BASE_URL=http://localhost:3000/result-verification
STORAGE_PROVIDER=
STORAGE_BUCKET=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Cloudinary: server-only secrets. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
