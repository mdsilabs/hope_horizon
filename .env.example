# Public project identity is pinned in lib/supabase/config.ts.
# Values here can be overridden locally/deployed, but the URL MUST match
# the pinned project. Only public data goes in this tracked example file.
NEXT_PUBLIC_SUPABASE_URL=https://iwfpdwihinhcwjgvmfei.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QLi8sSbByVHa9luUvJFLeA_1ouCrR7Q

# Server secrets: set these in Vercel -> Project -> Settings ->
# Environment Variables and in your local, untracked .env.local only.
# Prefer a rotated Supabase secret key (SUPABASE_SECRET_KEY).
# Legacy SUPABASE_SERVICE_ROLE_KEY is a fallback for existing deployments.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo data must not accidentally be seeded into the production project.
ALLOW_DEMO_SEED=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Hope Horizon Academy"
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
QR_VERIFICATION_BASE_URL=http://localhost:3000/result-verification
STORAGE_PROVIDER=
STORAGE_BUCKET=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
